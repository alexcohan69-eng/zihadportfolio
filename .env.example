# --- Database ---
MONGODB_URI=

# --- Admin auth (single shared admin identity, see lib/auth.ts) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OAuth providers (NextAuth client login, see auth.ts) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Email notifications (contact form, orders, messages) ---
RESEND_API_KEY=

# --- Site ---
NEXT_PUBLIC_BASE_URL=

# --- Telegram bot (see lib/telegram/) ---
# Token from @BotFather. Required to start the bot in any mode.
TELEGRAM_BOT_TOKEN=
# "polling" (default, local dev) or "webhook" (deployed).
TELEGRAM_BOT_MODE=polling
# Public HTTPS URL Telegram should push updates to. Required when
# TELEGRAM_BOT_MODE=webhook. Should point at /api/telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# Optional shared secret Telegram echoes back on webhook requests so forged
# requests can be rejected. Recommended when TELEGRAM_BOT_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=
